---
import "../styles/global.css";

interface Props {
  title: string;
  active: "images" | "packages";
}

const { title, active } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Container Registry Index</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={base}>📦 Container Registry Index</a>
      <nav class="tabs">
        <a href={base} class={active === "images" ? "active" : ""}>Images</a>
        <a href={`${base}packages/`} class={active === "packages" ? "active" : ""}>Packages</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
